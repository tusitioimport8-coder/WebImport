# --- Etapa 1: Compilación ---
FROM node:20-alpine AS builder

WORKDIR /app

# Activar Corepack en Node.js (habilita pnpm de forma nativa sin pasar por npm ni musl/glic)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copiar archivos de dependencias
COPY package.json pnpm-lock.yaml ./

# Si tu proyecto usa monorepo/workspaces, descompleta la siguiente línea:
# COPY pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm run build

# --- Etapa 2: Servidor Nginx ---
FROM nginx:alpine

# Reemplaza 'Frontend' por la carpeta real generada en dist/ (ej. dist/tu-app/browser)
COPY --from=builder /app/dist/Frontend/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]